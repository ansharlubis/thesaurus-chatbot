{
  "name": "thesaurus-chatbot",
  "version": "1.0.0",
  "description": "Simple chat frontend in TypeScript that communicates with Ollama",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && sass styles.scss styles.css",
    "build:css": "sass styles.scss styles.css",
    "watch:css": "sass styles.scss styles.css --watch",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "serve": "npx http-server . -p 3000"
  },
  "keywords": [
    "typescript",
    "chat",
    "ollama",
    "frontend"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "http-server": "^14.0.0",
    "sass": "^1.89.2",
    "typescript": "^5.0.0"
  }
}
